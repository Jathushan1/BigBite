# Aiven Cloud MySQL
DB_URL=jdbc:mysql://mysql-13ba3984-jathushansundararasu-23c8.l.aivencloud.com:16805/defaultdb?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=<YOUR_AIVEN_PASSWORD>

# Server Configuration
PORT=8080
JWT_SECRET=JWT_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# Default Seeded Super Admin Credentials (auto-created on startup)
APP_ADMIN_EMAIL=admin@bigbite.com
APP_ADMIN_PASSWORD=Admin@123

# Demo data: seeded once when the branches table is empty.
#   Branch codes: CMB03 (Colombo, open 24h), KDY01 (Kandy), GLE01 (Galle, no takeaway / no COD)
#   manager.<code>@bigbite.lk / Manager@123   (e.g. manager.cmb03@bigbite.lk)
#   staff.<code>@bigbite.lk   / Staff@123
#   rider.<code>@bigbite.lk   / Rider@123
#   customer@bigbite.lk       / Customer@123
APP_SEED_DEMO=true

# Links in emails point here
APP_FRONTEND_URL=http://localhost:3000

# Email. Leave APP_MAIL_MOCK=true to use the in-memory outbox shown at http://localhost:3000/dev/outbox
APP_MAIL_MOCK=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=<gmail app password>

